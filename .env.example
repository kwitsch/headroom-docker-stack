# Tailscale auth key (https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# Hostname of the node in the tailnet
TS_HOSTNAME=headroom-stack

# ACL tag(s) for the node
TS_TAGS=tag:headroom

# Headroom configuration is baked into the image (headroom/Dockerfile).

# Optional mitmproxy routing toggles (default 1 = route to Headroom; set to 0
# to bypass a provider without a rebuild).
#MITM_ROUTE_HEADROOM=1
#MITM_ROUTE_OPENAI=1
#MITM_ROUTE_GEMINI=1
