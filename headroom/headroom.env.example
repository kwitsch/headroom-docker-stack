# =============================================================================
# Headroom – configuration for the Docker Compose service
# Scenario: 1 user, Claude Code, Anthropic team plan (subscription)
# Strategy: maximize prefix-cache stability, compress only in the
#           live zone; recompact cold turns instead of resending them.
# Wired into the Compose service:  env_file: [headroom/headroom.env]
# State persistence:  /var/headroom:/data  (HEADROOM_WORKSPACE_DIR)
# =============================================================================

# --- Network (container) ---
HEADROOM_HOST=0.0.0.0
HEADROOM_PORT=8787

# --- Core: cache mode instead of token mode ---
# Claude Code lives on the Anthropic prompt cache (cache reads count heavily
# reduced against the team-plan limits). "cache" freezes old turns and
# compresses only new content -> no cache bust from rewritten prefixes.
HEADROOM_MODE=cache

# Forward original request bytes unchanged as long as no transform
# changes the body -> the Anthropic cache key stays stable.
HEADROOM_PROXY_PYTHON_FORWARDER_MODE=byte_faithful

# Union the anthropic-beta header per session: Claude Code occasionally drops
# beta tokens between turns; without sticky union -> cache miss mid-session.
HEADROOM_BETA_HEADER_STICKY=enabled

# Strip internal x-headroom-* headers before upstream (default, pinned explicitly).
HEADROOM_STRIP_INTERNAL_HEADERS=enabled

# --- Cold-prefix optimization ---
# When the provider cache has expired (cold), recompact the prefix instead
# of expensively resending it 1:1; TTL observation sharpens cold detection.
HEADROOM_COLD_RECOMPACT=1
HEADROOM_DEDUPE=1
HEADROOM_CACHE_TTL_LEARN=1

# Reasoning compaction: a no-op for Claude (reasoning is an encrypted
# handle, cheap to resend anyway) – only latency risk, no gain.
HEADROOM_THINKING_COMPACT=0

# --- Cost-aware model routing ---
# Rule 1: Claude requests <= 5000 input tokens without declared tools -> Haiku.
#   from_models restricts this to Anthropic models (multi-provider setup:
#   without from_models, small OpenAI/Gemini requests would also get
#   rewritten to claude-haiku - wrong API format). IDs must exactly match
#   what Claude Code sends (check the proxy log / /stats);
#   [1m] suffixes included as a precaution. Deliberately placed BEFORE the
#   Opus rule (first match wins), so that small tool-free Opus requests also
#   land on Haiku instead of only on Opus 4.8.
# Rule 2: all remaining Opus 5 requests -> Opus 4.8.
#   Bypass/passthrough requests are never rerouted.
HEADROOM_MODEL_ROUTER_ENABLED=1
HEADROOM_MODEL_ROUTES=[{"name":"small-no-tools-to-haiku","from_models":["claude-opus-5","claude-opus-5[1m]","claude-sonnet-5","claude-sonnet-5[1m]","claude-opus-4-8"],"max_input_tokens":5000,"require_no_tools":true,"to_model":"claude-haiku-4-5"},{"name":"opus5-to-opus48","from_models":["claude-opus-5","claude-opus-5[1m]"],"to_model":"claude-opus-4-8"}]

# --- Resources ---
# WORKERS=1: a single uvicorn process -> in-memory state (TOIN, TTL learning)
# stays consistent; multiple workers would fragment it.
HEADROOM_WORKERS=1
# limit_concurrency: outer uvicorn gate. From this many concurrent
# in-flight requests, the server immediately returns HTTP 503 ("Exceeded
# concurrency limit") - NO queueing, and the running request counts
# itself too. Reached quickly with parallel workflows/subagents.
# A pure counter cap, costs no CPU itself. The real limit is RAM
# (every in-flight request holds a message buffer) -> tune against
# `docker stats` on a 16 GB host. Keep a finite cap deliberately: a clean 503 instead
# of an OOM kill (which would destroy the in-memory state).
HEADROOM_LIMIT_CONCURRENCY=64

# --- Rate limiting OFF ---
# Headroom's own rate limiter (default: 60 req/min, 100k tok/min) is pure
# overhead for 1 user + subscription: the real quota enforcement sits
# with Anthropic. Parallel workflows/subagents blow through 60 req/min immediately.
# Triple-secured (a wrong env var is silently ignored): the enable toggle
# is off + both limits set to practically infinite. If it doesn't take effect
# (the dashboard counter keeps rising), check the exact switch via
# `headroom proxy --help` (probably the CLI flag --no-rate-limit).
HEADROOM_RATE_LIMIT_ENABLED=0
HEADROOM_RATE_LIMIT_REQUESTS_PER_MINUTE=1000000
HEADROOM_RATE_LIMIT_TOKENS_PER_MINUTE=1000000000

# --- Telemetry & state ---
# Telemetry is purely local, feeds /stats and the stack's dashboard.
HEADROOM_TELEMETRY=on
# Cost tracking OFF: prices saved tokens via the LiteLLM price list. Under
# a team plan (subscription, no per-token billing) this is meaningless, and
# LiteLLM can't map current/routed model IDs -> throws the red line
# "Provider List: https://docs.litellm.ai/..." on every request.
# The token-savings tiles (telemetry) are unaffected by this.
# A wrong env var is silently ignored (no crash). If it doesn't take effect,
# check the exact switch via `headroom proxy --help` -> probably add the
# CLI flag `--no-cost-tracking` to the Compose command.
HEADROOM_COST_TRACKING_ENABLED=0
# Savings state, TOIN models and TTL observations must survive
# restarts, otherwise nothing gets learned.
HEADROOM_STATELESS=false
HEADROOM_WORKSPACE_DIR=/data

# --- Output shaping (output-token reduction) ---
# Cache-safe: appends a terse note to the system prompt TAIL (prefix cache
# stays intact), lowers thinking effort only on routine post-tool turns, full
# effort on new questions/errors. Output tokens weigh heavily -> a quota lever.
# Only takes effect after a container RE-CREATE (env_file); `docker compose up -d`,
# not `restart`. Verification: `docker exec headroom headroom output-savings`.
#
# TWO prerequisites, otherwise the dashboard tile stays at "—":
#  (a) Beta channel: the shaper is a beta feature and is inactive without
#      HEADROOM_ROLLOUT_CHANNEL=beta. Caution: beta is a broader
#      opt-in (may enable further beta behavior) -> watch cache behavior
#      after enabling it.
#  (b) Learned baseline (only for personalization + the dashboard measurement
#      tile; the shaper STEERS even without it, using the default level):
#      `headroom learn --verbosity` reads agent session logs under
#      ~/.claude/projects/ -> that's the CLIENT machine, NOT this
#      headless proxy (no Claude Code, no sessions here). `docker exec`
#      on the proxy finds nothing. Flow in a split setup: run learn on the
#      client (--apply produces verbosity.json), then copy this verbosity.json
#      into the proxy's Headroom config/workspace root (/data).
#      Without a baseline, the dashboard tile stays "—" (Headroom #1296), the
#      shaping itself still runs regardless.
HEADROOM_ROLLOUT_CHANNEL=beta
HEADROOM_OUTPUT_SHAPER=1
# 10% unshaped control group -> the dashboard shows a MEASURED instead of an
# estimated number. Costs minimal savings, but delivers a solid baseline in return.
HEADROOM_OUTPUT_HOLDOUT=0.1
